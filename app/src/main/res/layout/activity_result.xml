<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_result.xml - Screen 3: Result / Stress Meter Screen
    Layout: ScrollView > ConstraintLayout
    Contains: Loading text, stress ProgressBar + label, outcome card, Next/Finish button
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- ── Loading State ────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvCalculating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="⚙️ Calculating your week..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Stress Meter Card ───────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvCalculating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Row: "Stress Level" label + numeric percentage -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧠 Stress Level"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- Numeric label - accessible alongside colour -->
                    <TextView
                        android:id="@+id/tvStressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/stress_low"
                        android:contentDescription="Stress percentage" />
                </LinearLayout>

                <!-- Stress ProgressBar - colour changes per stress band -->
                <ProgressBar
                    android:id="@+id/progressBarStress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/card_bg_alt"
                    android:progressTint="@color/stress_low"
                    android:contentDescription="Stress level progress bar" />

                <!-- Text label - accessible description of stress state -->
                <TextView
                    android:id="@+id/tvStressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="😊 Low Stress: You're doing great!"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textAlignment="center"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Outcome Message Card ──────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardOutcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardStress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Outcome"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_gold"
                    android:paddingBottom="10dp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvOutcomeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Next Week / Finish Button ────────────────────────── -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Next Week →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/accent_gold"
            app:layout_constraintTop_toBottomOf="@id/cardOutcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
