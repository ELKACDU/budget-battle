<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml - Screen 1: Start Screen
    Layout: ScrollView > ConstraintLayout
    Contains: App title, RadioGroup (income), SeekBar (budget), Start button
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- ── App Icon / Title ─────────────────────────────────── -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="💰 Budget Battle"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@color/accent_gold"
            android:textAlignment="center"
            android:letterSpacing="0.02"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simulate your student budget.\nFace the consequences."
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.3"
            app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gold divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:background="@color/accent_gold"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Income Source Card ───────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardIncome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 Income Source"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPartTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💼  Part-time Job"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_gold"
                        android:textSize="15sp"
                        android:paddingVertical="10dp" />

                    <RadioButton
                        android:id="@+id/rbFamily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👨‍👩‍👧  Family Support"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_gold"
                        android:textSize="15sp"
                        android:paddingVertical="10dp" />

                    <RadioButton
                        android:id="@+id/rbCentrelink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏛️  Centrelink"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/accent_gold"
                        android:textSize="15sp"
                        android:paddingVertical="10dp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Budget SeekBar Card ──────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBudget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardIncome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Row: label + live budget amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💵 Weekly Budget"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvBudgetAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$200"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_gold" />
                </LinearLayout>

                <!-- SeekBar: primary touch interaction for budget -->
                <SeekBar
                    android:id="@+id/seekBarBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:progressTint="@color/accent_gold"
                    android:thumbTint="@color/accent_gold" />

                <!-- Min / Max labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$50"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$500"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Start Button ─────────────────────────────────────── -->
        <Button
            android:id="@+id/btnStartWeek"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="🎮  START WEEK 1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/accent_gold"
            app:layout_constraintTop_toBottomOf="@id/cardBudget"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
