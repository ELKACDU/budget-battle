<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_weekly_decision.xml - Screen 2: Weekly Decision Screen
    Layout: ScrollView > ConstraintLayout
    Contains: Week title, budget header, scenario card, category options, SeekBar, total sum breakdown, Confirm button
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- ── Week Header ──────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvWeekTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Week 1 of 4"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Budget hint row -->
        <TextView
            android:id="@+id/tvBudgetHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your weekly budget: $200"
            android:textSize="13sp"
            android:textColor="@color/accent_gold"
            app:layout_constraintTop_toBottomOf="@id/tvWeekTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Scenario Card ────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardScenario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvBudgetHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📌 This Week's Scenario"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_gold"
                    android:paddingBottom="10dp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvWeekDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your rent is due this week…"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Spend Decision Card ──────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSpend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardScenario"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Instruction Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏷️ Select an expense option to set its budget:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_gold"
                    android:letterSpacing="0.02" />

                <!-- 3 Category Selection Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="3">

                    <!-- Option 1 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCat1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/accent_purple"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvCatName1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏠 Rent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:singleLine="true"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvCatAmount1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="$120"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Option 2 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCat2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_bg_alt"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvCatName2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛒 Food"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:singleLine="true"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvCatAmount2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="$60"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_gold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Option 3 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCat3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_bg_alt"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvCatName3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🚌 Transit"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:singleLine="true"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvCatAmount3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="$20"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_gold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Active Option Label & Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvActiveCategoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Adjusting: 🏠 Rent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvSpendAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$120"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_gold" />
                </LinearLayout>

                <!-- SeekBar: primary touch interaction for currently active category -->
                <SeekBar
                    android:id="@+id/seekBarSpend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:progressTint="@color/accent_purple"
                    android:thumbTint="@color/accent_purple" />

                <!-- $0 / $max labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$0"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMaxSpend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$500"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ── Live Itemized Total Sum Box ─────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card_bg_alt"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📊 Total Week Spending:"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvTotalWeeklySpend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$200"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/stress_low" />
                        </LinearLayout>

                        <!-- Breakdown formula line -->
                        <TextView
                            android:id="@+id/tvBreakdownSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Breakdown: $120 + $60 + $20"
                            android:textSize="12sp"
                            android:textColor="@color/text_muted" />

                        <!-- Budget status indicator -->
                        <TextView
                            android:id="@+id/tvBudgetStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="✅ Within your weekly budget"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/stress_low" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Confirm Button ───────────────────────────────────── -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="✅  CONFIRM TOTAL: $200"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/accent_purple"
            app:layout_constraintTop_toBottomOf="@id/cardSpend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
